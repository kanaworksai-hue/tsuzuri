/* Model download */
"Tsuzuri needs a speech model and two permissions. Your voice never leaves this Mac." = "Tsuzuri को एक स्पीच मॉडल और दो अनुमतियों की ज़रूरत है। आपकी आवाज़ कभी इस Mac से बाहर नहीं जाती।";
"Speech Model" = "स्पीच मॉडल";
